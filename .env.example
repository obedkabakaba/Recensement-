# Copier ce fichier en .env et l'adapter.
# Base de données : SQLite en local, PostgreSQL (Supabase) en production.
DECENSIO_DATABASE_URL=sqlite:///decensio.db
# DECENSIO_DATABASE_URL=postgresql+psycopg://utilisateur:motdepasse@hote:5432/postgres

# Secret servant à pseudonymiser les identifiants (NIN) et les noms. À garder hors du code.
DECENSIO_SECRET=changer-ce-secret

# Clé d'accès aux routes d'écriture de l'API (import, synchronisation, décisions).
DECENSIO_API_KEY=changer-cette-cle

# 1 = conserver les noms en clair (visibles par les vérificateurs) ; 0 = ne garder que des clés phonétiques.
DECENSIO_STOCKER_NOMS=0

# Seuils de couverture (part de la population estimée déjà enregistrée).
DECENSIO_SEUIL_VERT=0.90
DECENSIO_SEUIL_ORANGE=0.70
DECENSIO_SEUIL_SURCOUVERTURE=1.15
